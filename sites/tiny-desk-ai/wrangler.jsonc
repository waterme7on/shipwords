{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Full Tiny Desk-style site at app.shipwords.yololab.cc. Mock upstream + AI-generated dog-band media.
  // Payments are intentionally disabled until a Stripe test key is added; mock mode requires a test-mode payment credential.
  "name": "tiny-desk-ai",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "routes": [{ "pattern": "app.shipwords.yololab.cc", "custom_domain": true }],
  "vars": {
    "EMAIL_FROM": "noreply@yololab.cc",
    "APP_URL": "https://app.shipwords.yololab.cc",
    "UPSTREAM_MOCK": "1",
    "UPSTREAM_MOCK_RESULT": "assets/tinydesk/mock-result.mp4",
    "UPSTREAM_MOCK_RESULT_SILENT": "assets/tinydesk/mock-result.mp4",
    "RYBBIT_UPSTREAM": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiny-desk-ai",
      "database_id": "6d25576c-d27a-4a89-8e4f-490568361c0b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "OUTPUTS", "bucket_name": "tiny-desk-ai-outputs" }],
  "send_email": [{ "name": "EMAIL" }],
  "workflows": [
    {
      "name": "tiny-desk-ai-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow"
    }
  ]
}
